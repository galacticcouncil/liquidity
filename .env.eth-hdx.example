# ── pool: ETH/HDX  (copy to .env.eth-hdx) ───────────────────────────────────
# This pool's own hook, printed by 00_DeployBandHook (run it once per pool).
HOOK=

# currency0 = native ETH; currency1 = bridged HDX.
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=
TICK_SPACING=60

# Price source: the ratio of two USD feeds, ETH/USD ÷ HDX/USD = HDX per ETH. Each feed is named
# with the token it prices, in any order; the source sorts them. A feed named with the wrong
# token turns the price ~248,000 ticks upside down, which EXPECTED_TICK catches. No HDX/ETH
# oracle is needed.
SOURCE=ratio
FEED_A=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9   # Chainlink ETH/USD
FEED_A_PRICES=0x0000000000000000000000000000000000000000   # ETH
FEED_B=                        # HDX/USD ManagedOracle, the same one HDX/HOLLAR uses
FEED_B_PRICES=                 # HDX's address

# The tick the market implies right now. The script reads each token's decimals from the token
# itself, so use the same ones here: cast call <token> "decimals()(uint8)" (HDX is 12 on Hydration).
# Example at $2,400 per ETH and $0.01 per HDX, 18/12 decimals: raw HDX per raw ETH =
# 240,000 × 1e12 / 1e18 = 0.24 -> tick = ln(0.24) / ln(1.0001) ≈ -14,272. Recompute at launch.
EXPECTED_TICK=
TICK_TOLERANCE=100

FEE_FLOOR_PPM=3000
FEE_CAP_PPM=20000
FEE_SLOPE_PPM=1000000
# The ratio is as stale as its older feed, and ETH/USD may legitimately be up to 24h old (it
# updates on a 0.5% move or daily), so this must allow 24h, as on ETH/HOLLAR. The cost: a
# stalled HDX/USD feed goes unnoticed on-chain for up to 28h; the off-chain watchdog must
# alert on it by its own 30-min heartbeat.
STALE_AFTER_S=100800           # 28h
HALF_BAND_TICKS=1000
BACKSTOP_HALF_TICKS=16000
BACKSTOP_BPS=3500
TRIGGER_TICKS=500
GUARD_TICKS=300                # configure refuses <= 264 at a 2% cap (dead band + 50)
AUTO_RECENTER=false            # true: also recenter at the end of the swap that makes it due (README)

# 02_Fund, in raw units; the native amount0 is sent as msg.value.
FUND_AMOUNT0=
FUND_AMOUNT1=

# AnchorPool, only if 01_SetupPool or 02_Fund says the pool is off the oracle.
ANCHOR_MAX0=1000000000000000       # 0.001 ETH
ANCHOR_MAX1=
ANCHOR_LIQUIDITY=1000000000000
