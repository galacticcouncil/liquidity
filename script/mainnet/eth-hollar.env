# ETH/HOLLAR on Robinhood Chain: the settings both launch steps read. No keys here: each person's key
# goes in their own .env as PRIVATE_KEY.
#
# deployer:  set -a; source script/mainnet/eth-hollar.env; set +a
#            forge script script/00_DeployBandHook.s.sol --rpc-url robinhood --broadcast --slow
#            (put the printed hook in HOOK below, then source this file again)
#            forge script script/01_SetupPool.s.sol --rpc-url robinhood --broadcast --slow
#            forge script script/03_HandOff.s.sol --rpc-url robinhood --broadcast --slow
# owner:     script/fund.sh check
#            script/fund.sh send
#            (step by step, with what each value means: script/mainnet/FUNDING.md)
CHAIN_ID=4663
RPC=robinhood

# Filled by the deployer: the hook printed by 00, and the tick the market implies when 01 runs:
# ln(ETH price in USD) / ln(1.0001), both tokens 18 decimals (e.g. $2,500 -> 78,244).
HOOK=0x5C9c3b13986d2b9F49849064190C52Da5Ca050c0
EXPECTED_TICK=78302
TICK_TOLERANCE=100
# The wallet that funds the pool and owns the hook after 03.
NEW_OWNER=0x59197B192F4104982196dA9A003C934736f0aC3D

# currency0 = native ETH; currency1 = HOLLAR (Wormhole NTT from Hydration, 18 decimals)
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=0xD1dc3517732c98502b5c1ba2389AcA9E9016d89a
TICK_SPACING=10

# Chainlink ETH/USD (8 dec, 0.5% deviation / 24h heartbeat), HOLLAR treated as $1
SOURCE=single
FEED=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9
FEED_PRICES=0x0000000000000000000000000000000000000000

FEE_FLOOR_PPM=800              # 0.08%
FEE_CAP_PPM=10000              # 1%
FEE_SLOPE_PPM=1000000          # +1% fee per 1% divergence
STALE_AFTER_S=100800           # 28h: ETH/USD heartbeat is 24h
HALF_BAND_TICKS=700            # +-7%
BACKSTOP_HALF_TICKS=11000      # /3..x3
BACKSTOP_BPS=3500
TRIGGER_TICKS=350              # ~3.5% drift
GUARD_TICKS=200                # ~2%
AUTO_RECENTER=true             # also recenter at the end of the swap that makes it due

# Filled before the owner's step: the ETH to deposit, in ETH (e.g. 7.5). fund.sh adds HOLLAR of
# equal value at the oracle price; the wallet needs that much HOLLAR plus ANCHOR_MAX1.
FUND_ETH=
# The code the owner's wallet borrows for its one transaction (eth-infinitism, ERC-4337 v0.8).
SIMPLE7702=0x4Cd241E8d1510e30b2076397afc7508Ae59C66c9
# The most the anchor may spend to put a moved price back, if others' liquidity is in the way.
ANCHOR_MAX0=1000000000000000       # 0.001 ETH
ANCHOR_MAX1=1000000000000000000    # 1 HOLLAR
