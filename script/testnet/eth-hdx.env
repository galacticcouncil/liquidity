# ETH/HDX on Robinhood testnet: the mainnet example's settings, with the stand-ins' addresses.
# Sourced by rehearse.sh after broadcast/testnet/<chain id>/{standins,hooks,ticks}.env.
HOOK=$HOOK_ETH_HDX
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=$HDX
TICK_SPACING=60
SOURCE=ratio
FEED_A=$ETH_USD_FEED
FEED_A_PRICES=0x0000000000000000000000000000000000000000
FEED_A_MAX_AGE_S=100800
FEED_B=$HDX_USD_FEED
FEED_B_PRICES=$HDX
FEED_B_MAX_AGE_S=7200
EXPECTED_TICK=$EXPECTED_TICK_ETH_HDX
TICK_TOLERANCE=100
FEE_FLOOR_PPM=3000
FEE_CAP_PPM=20000
FEE_SLOPE_PPM=1000000
STALE_AFTER_S=100800
HALF_BAND_TICKS=1000
BACKSTOP_HALF_TICKS=16000
BACKSTOP_BPS=3500
TRIGGER_TICKS=500
GUARD_TICKS=300
AUTO_RECENTER=false
# Ben's deposit: 0.002 ETH + 655 HDX.
FUND_AMOUNT0=2000000000000000
FUND_AMOUNT1=655000000000000
ANCHOR_MAX0=1000000000000000       # 0.001 ETH
ANCHOR_MAX1=100000000000000        # 100 HDX
