# HDX/HOLLAR on Robinhood testnet: the mainnet example's settings, with the stand-ins' addresses.
# Sourced by rehearse.sh after broadcast/testnet/<chain id>/{standins,hooks,ticks}.env.
HOOK=$HOOK_HDX_HOLLAR
CURRENCY0=$HDX
CURRENCY1=$HOLLAR
TICK_SPACING=60
SOURCE=single
FEED=$HDX_USD_FEED
FEED_PRICES=$HDX
EXPECTED_TICK=$EXPECTED_TICK_HDX_HOLLAR
TICK_TOLERANCE=100
FEE_FLOOR_PPM=3000
FEE_CAP_PPM=20000
FEE_SLOPE_PPM=1000000
STALE_AFTER_S=7200
HALF_BAND_TICKS=1000
BACKSTOP_HALF_TICKS=16000
BACKSTOP_BPS=3500
TRIGGER_TICKS=500
GUARD_TICKS=300
AUTO_RECENTER=false
# The owner's deposit: 10,000 HDX + 76 HOLLAR.
FUND_AMOUNT0=10000000000000000
FUND_AMOUNT1=76000000000000000000
ANCHOR_MAX0=100000000000000        # 100 HDX
ANCHOR_MAX1=1000000000000000000    # 1 HOLLAR
