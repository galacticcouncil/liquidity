# ETH/HOLLAR on Robinhood testnet: the mainnet example's settings, with the stand-ins' addresses.
# Sourced by rehearse.sh after broadcast/testnet/<chain id>/{standins,hooks,ticks}.env.
HOOK=$HOOK_ETH_HOLLAR
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=$HOLLAR
TICK_SPACING=10
SOURCE=single
FEED=$ETH_USD_FEED
FEED_PRICES=0x0000000000000000000000000000000000000000
EXPECTED_TICK=$EXPECTED_TICK_ETH_HOLLAR
TICK_TOLERANCE=100
FEE_FLOOR_PPM=800
FEE_CAP_PPM=10000
FEE_SLOPE_PPM=1000000
STALE_AFTER_S=100800
HALF_BAND_TICKS=700
BACKSTOP_HALF_TICKS=11000
BACKSTOP_BPS=3500
TRIGGER_TICKS=350
GUARD_TICKS=200
AUTO_RECENTER=false
# Ben's deposit, small because testnet ETH comes from a faucet: 0.002 ETH + 5 HOLLAR.
FUND_AMOUNT0=2000000000000000
FUND_AMOUNT1=5000000000000000000
ANCHOR_MAX0=1000000000000000       # 0.001 ETH
ANCHOR_MAX1=1000000000000000000    # 1 HOLLAR
