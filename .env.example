# ── shared settings: copy to .env, which forge loads by itself ──────────────
# Deployer EOA: deploys every hook and is each hook's first owner until 03_HandOff.
PRIVATE_KEY=
# Final owner of every hook (multisig on Robinhood Chain), for 03_HandOff. It must accept a
# plain ETH transfer: withdraw on the native pools pushes ETH to it with a call.
NEW_OWNER=

# Robinhood Chain: rpc alias "robinhood" is in foundry.toml (chain id 4663).
# PoolManager 0x8366a39CC670B4001A1121B8F6A443A643e40951 is hardcoded in the scripts.
#
# Each pool has its own hook and its own settings file, copied from its example:
#   .env.eth-hollar   from .env.eth-hollar.example
#   .env.hdx-hollar   from .env.hdx-hollar.example
#   .env.eth-hdx      from .env.eth-hdx.example
# Load one before running a per-pool script:   set -a; source .env.eth-hollar; set +a
