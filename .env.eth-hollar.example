# ── pool: ETH/HOLLAR  (copy to .env.eth-hollar) ─────────────────────────────
# This pool's own hook, printed by 00_DeployBandHook (run it once per pool).
HOOK=

# currency0 = native ETH; currency1 = bridged HOLLAR (fill in when bridged).
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=
TICK_SPACING=10
TOKEN0_DECIMALS=18             # ETH
TOKEN1_DECIMALS=               # HOLLAR: confirm the bridged decimals

# Price source: one Chainlink feed, ETH/USD (8 dec, 0.5% deviation / 24h heartbeat), with
# HOLLAR treated as $1. The feed prices ETH, which is currency0.
SOURCE=single
FEED=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9
FEED_PRICES_TOKEN=0

# The tick the market implies right now, checked against the new source before anything is
# configured: tick = ln(raw token1 per raw token0) / ln(1.0001).
# Example at $2,400 per ETH, 18/18 decimals: ln(2400) / ln(1.0001) ≈ 77,836. Recompute at launch.
EXPECTED_TICK=
TICK_TOLERANCE=100             # ~1%: normal feed lag passes, a wrong order or decimals does not

FEE_FLOOR_PPM=800              # 0.08%
FEE_CAP_PPM=10000              # 1%
FEE_SLOPE_PPM=1000000          # +1% fee per 1% divergence
STALE_AFTER_S=100800           # 28h: ETH/USD heartbeat is 24h
HALF_BAND_TICKS=700            # ±7%
BACKSTOP_HALF_TICKS=11000      # ÷3..×3
BACKSTOP_BPS=3500
TRIGGER_TICKS=350              # ~3.5% drift
GUARD_TICKS=200                # ~2%; configure refuses <= 161 at a 1% cap (dead band + 50)
AUTO_RECENTER=false            # true: also recenter at the end of the swap that makes it due (README)

# 02_Fund, in raw units; the native amount0 is sent as msg.value.
FUND_AMOUNT0=
FUND_AMOUNT1=

# AnchorPool, only if 01_SetupPool or 02_Fund says the pool is off the oracle. The most it may
# spend of each token (raw units), and the liquidity of its tiny straddling position.
ANCHOR_MAX0=1000000000000000       # 0.001 ETH
ANCHOR_MAX1=1000000000000000000    # 1 HOLLAR at 18 decimals
ANCHOR_LIQUIDITY=1000000000000
