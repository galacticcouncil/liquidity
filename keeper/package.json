{
  "name": "bandhook-keeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:fork": "FORK=1 node --import tsx --test src/keeper.fork.test.ts"
  },
  "dependencies": {
    "viem": "2.21.55"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
