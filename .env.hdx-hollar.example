# ── pool: HDX/HOLLAR  (copy to .env.hdx-hollar) ─────────────────────────────
# This pool's own hook, printed by 00_DeployBandHook (run it once per pool).
HOOK=

# Both tokens are Wormhole NTT from Hydration; HDX's address sorts first, so HDX is currency0.
CURRENCY0=0xb423C0B59C615793b0903668dc414e4fA3A64A33   # HDX, 12 decimals
CURRENCY1=0xD1dc3517732c98502b5c1ba2389AcA9E9016d89a   # HOLLAR, 18 decimals
TICK_SPACING=60

# Price source: the HDX/USD CheckedOracle (whm: Hydration's 10-min EMA over Wormhole, 8 dec), with
# HOLLAR treated as $1. FEED_PRICES names the token the feed prices (HDX); the source works
# out which way up the price goes from the two addresses.
SOURCE=single
FEED=0xD1a2198CBbC7cbfB602DF581D8614eD31682901D   # HDX/USD CheckedOracle
FEED_PRICES=0xb423C0B59C615793b0903668dc414e4fA3A64A33   # HDX

# The tick the market implies right now. The script reads each token's decimals from the token
# itself, so use the same ones here: cast call <token> "decimals()(uint8)".
# Examples at $0.01 per HDX, HDX 12 decimals, HOLLAR 18 decimals. Recompute at launch.
#   HDX is currency0: raw HOLLAR per raw HDX = 0.01 × 1e18 / 1e12 = 1e4  -> tick ≈  92,108
#   HDX is currency1: raw HDX per raw HOLLAR = 100 × 1e12 / 1e18 = 1e-4  -> tick ≈ -92,108
EXPECTED_TICK=
TICK_TOLERANCE=100

FEE_FLOOR_PPM=3000             # 0.3%
FEE_CAP_PPM=20000              # 2%
FEE_SLOPE_PPM=1000000
STALE_AFTER_S=7200             # 2h; the feed pushes on a 0.1% move, 6h heartbeat for now: a quiet spell past 2h pays the fee cap
HALF_BAND_TICKS=1000           # ±10%
BACKSTOP_HALF_TICKS=16000      # ÷5..×5
BACKSTOP_BPS=3500
TRIGGER_TICKS=500              # ~5%
GUARD_TICKS=300                # ~3%; configure refuses <= 264 at a 2% cap (dead band + 50)
AUTO_RECENTER=false            # true: also recenter at the end of the swap that makes it due (README)

# SafeFund: what the Safe deposits, in raw units.
FUND_AMOUNT0=
FUND_AMOUNT1=

# SafeFund: the most the batch's anchor may spend of each token (raw units) if someone else's
# liquidity is in the way; on an empty pool it spends nothing.
ANCHOR_MAX0=100000000000000        # 100 HDX (12 decimals)
ANCHOR_MAX1=1000000000000000000    # 1 HOLLAR (18 decimals)
