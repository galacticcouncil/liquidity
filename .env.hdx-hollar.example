# ── pool: HDX/HOLLAR  (copy to .env.hdx-hollar) ─────────────────────────────
# This pool's own hook, printed by 00_DeployBandHook (run it once per pool).
HOOK=

# Both tokens are bridged: sort their addresses so that CURRENCY0 < CURRENCY1.
CURRENCY0=
CURRENCY1=
TICK_SPACING=60
TOKEN0_DECIMALS=               # decimals of whichever token is currency0 (HDX is 12 on Hydration)
TOKEN1_DECIMALS=

# Price source: the HDX/USD ManagedOracle (wormhole-direct, 8 dec, 30-min heartbeat), with
# HOLLAR treated as $1. The feed prices HDX: FEED_PRICES_TOKEN is 0 if HDX is currency0,
# 1 if HDX is currency1.
SOURCE=single
FEED=                          # HDX/USD ManagedOracle
FEED_PRICES_TOKEN=

# Examples at $0.01 per HDX, HDX 12 decimals, HOLLAR 18 decimals. Recompute at launch.
#   HDX is currency0: raw HOLLAR per raw HDX = 0.01 × 1e18 / 1e12 = 1e4  -> tick ≈  92,108
#   HDX is currency1: raw HDX per raw HOLLAR = 100 × 1e12 / 1e18 = 1e-4  -> tick ≈ -92,108
EXPECTED_TICK=
TICK_TOLERANCE=100

FEE_FLOOR_PPM=3000             # 0.3%
FEE_CAP_PPM=20000              # 2%
FEE_SLOPE_PPM=1000000
STALE_AFTER_S=7200             # 2h: the feed heartbeats every 30 min
HALF_BAND_TICKS=1000           # ±10%
BACKSTOP_HALF_TICKS=16000      # ÷5..×5
BACKSTOP_BPS=3500
TRIGGER_TICKS=500              # ~5%
GUARD_TICKS=300                # ~3%; configure refuses <= 264 at a 2% cap (dead band + 50)
AUTO_RECENTER=false            # true: also recenter at the end of the swap that makes it due (README)

# 02_Fund, in raw units.
FUND_AMOUNT0=
FUND_AMOUNT1=

# AnchorPool, only if 01_SetupPool or 02_Fund says the pool is off the oracle.
ANCHOR_MAX0=
ANCHOR_MAX1=
ANCHOR_LIQUIDITY=1000000000000
